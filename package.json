{
  "name": "codetree-study-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "코드트리 문제 페이지 위에 여닫는 학습 서랍 (크롬 확장 MV3)",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
