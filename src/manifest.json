{
  "manifest_version": 3,
  "name": "코드트리 학습 서랍",
  "version": "0.1.0",
  "description": "코드트리 문제 페이지 위에 여닫는 학습 서랍. 코드 전에 생각할 질문, 단계별 힌트, 내 기록.",
  "minimum_chrome_version": "111",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["storage"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "코드트리 학습 서랍: 손잡이 숨기기/보이기", "default_icon": { "16": "icons/16.png", "48": "icons/48.png" } },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://www.codetree.ai/*", "https://codetree.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.codetree.ai/*", "https://codetree.ai/*"],
      "js": ["mainworld.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "commands": {
    "toggle-drawer": {
      "suggested_key": { "default": "Alt+Q" },
      "description": "서랍 열기/닫기"
    }
  },
  "web_accessible_resources": [
    { "resources": ["fonts/*"], "matches": ["https://www.codetree.ai/*", "https://codetree.ai/*"] }
  ]
}
